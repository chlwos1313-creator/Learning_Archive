# 이 파일을 복사해 .env 로 이름을 바꾸고 값을 채워 넣으세요.
# cp .env.example .env

# [필수] YouTube Data API v3 키 (Google Cloud Console 발급)
VITE_YOUTUBE_API_KEY=여기에_유튜브_API_키_입력

# [심화/선택] 생성형 AI 챗봇용 Gemini API 키
# https://aistudio.google.com/app/apikey 에서 발급
# 비워두면 챗봇이 내장 규칙 기반 파서로 동작합니다.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.0-flash
